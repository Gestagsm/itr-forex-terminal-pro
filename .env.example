# Use the PostgreSQL database shared by this app and your other project.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=your_shared_database
PGUSER=postgres
PGPASSWORD=replace_with_your_local_postgres_password

# Separate admin portal service. Set a unique password of 14+ characters.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4200
ADMIN_USERNAME=itr-admin
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_14_chars
ADMIN_TERMINAL_URL=http://127.0.0.1:4100
# Only enable when binding the admin service remotely behind a trusted HTTPS reverse proxy.
# ADMIN_HOST=0.0.0.0
# ADMIN_COOKIE_SECURE=1

# Optional: enable this only if the TimescaleDB extension is installed in this PostgreSQL server.
# The app detects an enabled extension and converts its table to a hypertable automatically.
# You can also enable it once in pgAdmin: CREATE EXTENSION IF NOT EXISTS timescaledb;

# Optional market simulator settings
# QUOTE_RATE=8
# RATE_SCALE=1
